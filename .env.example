# ==============================================================================
# ENVIRONMENT TEMPLATE - DO NOT STORE PRODUCTION SECRETS HERE
# ==============================================================================
# AGENT INSTRUCTION: Secrets and real API keys must never be stored in this file
# or read by AI assistants. Real keys belong strictly in your uncommitted .env file.
# ==============================================================================

PORT=3000
HOST=0.0.0.0
PYTHON_PATH=python3

# Discovery worker limits. Set DISCOVERY_INTERVAL_HOURS=0 to disable scheduled runs.
DISCOVERY_INTERVAL_HOURS=24
DISCOVERY_CONCURRENCY=2
DISCOVERY_MAX_ATTEMPTS=2
DISCOVERY_SOURCE_TIMEOUT_MS=60000
DISCOVERY_RETRY_BASE_DELAY_MS=500
DISCOVERY_STALE_RUN_MINUTES=5

# Owner-only application budgets. Guest requests are recorded but remain uncapped by the app.
AI_OWNER_DAILY_REQUEST_BUDGET=100
AI_OWNER_DAILY_TOKEN_BUDGET=100000
# Set false to block all outbound AI provider requests; local fallback behavior remains available.
AI_OUTBOUND_ENABLED=true

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/job_tracker
DATABASE_SSL=false

# Security & Cloudflare Access Configuration
# Explicit allowlist email; the forwarded email must match the verified Access JWT claim.
ALLOWED_USER_EMAIL=kkent908@gmail.com
# Cloudflare Zero Trust team domain and this Access application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
# Bearer token for automated cron triggers/scripts (Authorization: Bearer <API_SECRET_KEY>)
API_SECRET_KEY=change_this_to_a_random_secret_token
# Set to true to bypass auth in development if NODE_ENV=production test is needed
AUTH_BYPASS_DEV=false

# Optional Cloudflare Tunnel Token (if running with docker-compose --profile with-tunnel up)
TUNNEL_TOKEN=

# Optional AI Providers (System gracefully falls back to mock simulation if absent)
# Tier 1: TypeSafe AI (JEV model) for fast automated screening
TYPESAFE_API_KEY=
TYPESAFE_API_ENDPOINT=https://api.typesafe.ai/v1/noul

# Tier 2: Google Gemini for interactive deep analysis & cover letters
# Development / Staging Token (standard Google AI Studio secret name; used in local/staging to preserve production tokens)
GEMINI_API_KEY=
# Production Owner Key (Free Tier primary)
PROD_GEMINI_API_KEY_FREE=
# Production Owner Key (Pro/Paid backup if free tier hits 429)
PROD_GEMINI_API_KEY_PRO=
# Public Guest Key: Dedicated key for public portfolio visitors (isolates owner quota)
PROD_GUEST_GEMINI_API_KEY_FREE=
