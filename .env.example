PORT=3000
HOST=0.0.0.0
PYTHON_PATH=python3

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/job_tracker
DATABASE_SSL=false

# Security & Cloudflare Access Configuration
# Explicit allowlist email (Cloudflare Access will inject Cf-Access-Authenticated-User-Email)
ALLOWED_USER_EMAIL=kkent908@gmail.com
# Bearer token for automated cron triggers/scripts (Authorization: Bearer <API_SECRET_KEY>)
API_SECRET_KEY=change_this_to_a_random_secret_token
# Set to true to bypass auth in development if NODE_ENV=production test is needed
AUTH_BYPASS_DEV=false

# Optional Cloudflare Tunnel Token (if running with docker-compose --profile with-tunnel up)
TUNNEL_TOKEN=

# Optional AI Providers (System gracefully falls back to mock simulation if absent)
# Tier 1: TypeSafe AI (JEV model) for fast automated screening
TYPESAFE_API_KEY=
TYPESAFE_API_ENDPOINT=https://api.typesafe.ai/v1/noul

# Tier 2: Google Gemini for interactive deep analysis & cover letters
# Owner Tier 1: Free tier Google AI Studio key
GEMINI_API_KEY_FREE=
# Owner Tier 2: Pro/Paid backup key (used if free tier rate limit 429 is encountered)
GEMINI_API_KEY_PRO=
# Public Guest Key: Dedicated key used for public portfolio visitors (isolating owner quota)
GUEST_GEMINI_API_KEY=
# Fallback / standard key
GEMINI_API_KEY=
